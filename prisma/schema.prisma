generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_ASSIGNED
  TASK_DELETED
  COMMENT_ADDED
  COMMENT_DELETED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_LEFT
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  passwordHash  String
  createdAt     DateTime        @default(now())
  projects      Project[]
  memberships   ProjectMember[]
  assignedTasks Task[]
  comments      Comment[]
  activity      Activity[]
}

model Project {
  id        String          @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime        @default(now())
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]
  members   ProjectMember[]
  activity  Activity[]
}

// Access to a project and its tasks comes only from a membership row; the creator gets the OWNER row.
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]

  @@index([projectId, status])
  @@index([projectId, assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// One row per change, written in the same transaction as the change. Task details are copied so the history
// still reads correctly after the task is renamed or deleted (taskId is deliberately not a foreign key).
model Activity {
  id          String       @id @default(cuid())
  projectId   String
  actorId     String
  type        ActivityType
  taskId      String?
  taskTitle   String?
  fromStatus  TaskStatus?
  toStatus    TaskStatus?
  subjectName String?
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
