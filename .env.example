# Copy to .env (gitignored). Values match the local Postgres in docker-compose.yml.

# App and migrations (`npx prisma migrate dev`)
DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/team_task_board?schema=public"

# Integration tests only (tests/integration); never point at dev or production data
TEST_DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/team_task_board_test?schema=public"
